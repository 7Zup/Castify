<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: the user allows "Install unknown apps" for Castify once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 11+ package visibility: lets us check the screen exists before opening it. -->
    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
            <data android:scheme="package" />
        </intent>
    </queries>
    <application>
        <receiver
            android:name="app.castify.update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
