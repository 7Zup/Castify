<?xml version="1.0" encoding="utf-8"?>
<!-- Castify logo: red ribbon "C" (folded at the top, Netflix style) with white cast waves.
     Safe zone = central 66 dp. Same paths as tv/app banner.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- C body, shaded from dark red (left) to red (right) -->
    <path
        android:pathData="M67.5,36.6 A22,22 0 1,0 67.5,71.4"
        android:strokeWidth="11">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32" android:startY="54"
                android:endX="68" android:endY="54"
                android:startColor="#8E0610"
                android:endColor="#E50914" />
        </aapt:attr>
    </path>
    <!-- Fold over the top of the C -->
    <path
        android:pathData="M67.5,36.6 A22,22 0 0,0 39.5,41.9"
        android:strokeWidth="11"
        android:strokeColor="#E50914" />
    <!-- Cast waves -->
    <path android:fillColor="#FFFFFF" android:pathData="M47,60 a4,4 0 0,1 4,4 L47,64 z" />
    <path android:pathData="M47,55 a9,9 0 0,1 9,9" android:strokeWidth="3" android:strokeColor="#FFFFFF" />
    <path android:pathData="M47,50 a14,14 0 0,1 14,14" android:strokeWidth="3" android:strokeColor="#FFFFFF" />
</vector>
